{
  "name": "payment-api",
  "api_id": "payment-api",
  "org_id": "default",
  "active": true,

  "proxy": {
    "listen_path": "/api/",
    "target_url": "http://payment-app:8080/",
    "strip_listen_path": true,
    "enable_load_balancing": false
  },

  "use_keyless": false,
  "enable_jwt": true,
  "jwt_signing_method": "hmac",
  "jwt_source": "c3VwZXJzZWNyZXRwYXltZW50a2V5c3VwZXJzZWNyZXRwYXltZW50a2V5MTIzNDU2Nzg5",
  "jwt_identity_base_field": "sub",

  "auth": {
    "auth_header_name": "Authorization"
  },

  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true,
        "extended_paths": {
          "ignored": [
            {
              "path": "/api/auth/login",
              "method_actions": {
                "POST": {
                  "action": "no_action",
                  "code": 200,
                  "data": "",
                  "headers": {}
                }
              }
            },
            {
              "path": "/api/test-auth",
              "method_actions": {
                "GET": {
                  "action": "no_action",
                  "code": 200,
                  "data": "",
                  "headers": {}
                }
              }
            }
          ]
        }
      }
    }
  }
}